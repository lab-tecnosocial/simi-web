---
import { getImage } from "astro:assets";
import PageLayout from "../layouts/PageLayout.astro";
import LibrarySections from "../components/biblioteca/LibrarySections.jsx";
import bannerSrc from "../assets/images/juego/banner.jpg";
import "../styles/global.css";

const banner = await getImage({ src: bannerSrc });
---

<PageLayout
  titulo="Simiteca"
  descripcion="Boletines y cómics de SIMI para leer en línea"
  imagen={banner.src}
>
  <LibrarySections client:only="react" />
</PageLayout>
